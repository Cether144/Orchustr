typedef State = Map<String, dynamic>;
typedef NodeHandler = Future<State> Function(State state);

{{node_handlers}}

final List<NodeHandler> pipeline = [{{node_list}}];

Future<void> main() async {
  State state = {'input': 'hello from {{project_name}}'};
  for (final node in pipeline) {
    state = await node(state);
  }
  print('{{project_name}} finished: $state');
}
