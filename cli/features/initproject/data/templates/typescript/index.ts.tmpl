// {{repo_url}}/tree/main/bindings/typescript

type State = Record<string, unknown>;
type NodeHandler = (state: State) => Promise<State>;

{{node_handlers}}

const pipeline: NodeHandler[] = [{{node_list}}];

async function main(): Promise<void> {
  let state: State = { input: "hello from {{project_name}}" };
  for (const node of pipeline) {
    state = await node(state);
  }
  console.log("{{project_name}} finished:", state);
}

main().catch((error) => {
  console.error(error);
  process.exit(1);
});
